{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "appName": { "type": "string", "defaultValue": "streamguard-backend" },
    "environmentName": { "type": "string", "defaultValue": "streamguard-env" },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/samuelvallejo/streamguard-backend:main",
      "metadata": { "description": "Public image reference; use the immutable digest from the publishing workflow." }
    },
    "frontendOrigin": { "type": "string", "defaultValue": "https://streamguard-frontend.vercel.app" },
    "databaseUrl": { "type": "securestring", "minLength": 1 },
    "databaseUser": { "type": "securestring", "minLength": 1 },
    "databasePassword": { "type": "securestring", "minLength": 1 },
    "dataEncryptionKey": { "type": "securestring", "minLength": 32 },
    "jwtSecret": { "type": "securestring", "minLength": 32 }
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "tags": { "application": "streamguard", "environment": "production" },
      "properties": {
        "appLogsConfiguration": { "destination": "none" },
        "zoneRedundant": false,
        "workloadProfiles": [
          { "name": "Consumption", "workloadProfileType": "Consumption" }
        ]
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": { "application": "streamguard", "environment": "production" },
      "dependsOn": [ "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]" ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [ { "latestRevision": true, "weight": 100 } ]
          },
          "secrets": [
            { "name": "database-url", "value": "[parameters('databaseUrl')]" },
            { "name": "database-user", "value": "[parameters('databaseUser')]" },
            { "name": "database-password", "value": "[parameters('databasePassword')]" },
            { "name": "data-encryption-key", "value": "[parameters('dataEncryptionKey')]" },
            { "name": "jwt-secret", "value": "[parameters('jwtSecret')]" }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "backend",
              "image": "[parameters('image')]",
              "resources": { "cpu": 0.5, "memory": "1Gi" },
              "env": [
                { "name": "PORT", "value": "8080" },
                { "name": "SPRING_PROFILES_ACTIVE", "value": "cloud" },
                { "name": "FRONTEND_ORIGIN", "value": "[parameters('frontendOrigin')]" },
                { "name": "JDBC_DATABASE_URL", "secretRef": "database-url" },
                { "name": "PGUSER", "secretRef": "database-user" },
                { "name": "PGPASSWORD", "secretRef": "database-password" },
                { "name": "DATA_ENCRYPTION_KEY", "secretRef": "data-encryption-key" },
                { "name": "JWT_SECRET", "secretRef": "jwt-secret" },
                { "name": "MEDIA_STORAGE", "value": "database" },
                { "name": "MEDIA_DIR", "value": "/tmp/streamguard-media" },
                { "name": "MEDIA_WORK_DIR", "value": "/tmp/streamguard-work" },
                { "name": "MAX_VIEWERS", "value": "6" },
                { "name": "AI_PROVIDER", "value": "local-rules" }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": { "path": "/actuator/health", "port": 8080, "scheme": "HTTP" },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": { "path": "/actuator/health", "port": 8080, "scheme": "HTTP" },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                },
                {
                  "type": "Liveness",
                  "httpGet": { "path": "/actuator/health", "port": 8080, "scheme": "HTTP" },
                  "initialDelaySeconds": 60,
                  "periodSeconds": 30,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1,
            "rules": [
              { "name": "http-concurrency", "http": { "metadata": { "concurrentRequests": "20" } } }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "backendOrigin": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    }
  }
}
