# Backend configuration. Keep real values in the service environment, never in Git.
SPRING_PROFILES_ACTIVE=cloud
JDBC_DATABASE_URL=jdbc:postgresql://your-session-pooler.supabase.com:5432/postgres?sslmode=require
PGUSER=streamguard_backend.your-project-ref
PGPASSWORD=configure-in-render
FRONTEND_ORIGIN=https://streamguard-frontend.vercel.app
# Secret to sign the session JWT (32+ characters). Generate one: openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=ollama
OLLAMA_GATEWAY_URL=
OLLAMA_GATEWAY_TOKEN=
OLLAMA_MODEL=qwen3:4b-instruct
MEDIA_STORAGE=database
MEDIA_DIR=/tmp/streamguard/media
MEDIA_WORK_DIR=/tmp/streamguard/work
MAX_VIEWERS=6
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Private AES-GCM key: base64 encoding of 32 random bytes. Never commit a real key.
DATA_ENCRYPTION_KEY=
ARCHIVE_BUDGET_BYTES=209715200
