{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "appName": {
      "type": "string",
      "defaultValue": "streamguard-backend"
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "streamguard-env"
    },
    "environmentResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of the Container Apps environment. Use another group to reuse an existing environment instead of creating one (Azure for Students allows only one per subscription)."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/samuelvallejo/streamguard-backend@sha256:2a9c16ef3aa6f948510a988ec7ecb34624d2e2f11471a1c633f78c18cfff00a2",
      "metadata": {
        "description": "Public image reference; use the immutable digest from the publishing workflow."
      }
    },
    "frontendOrigin": {
      "type": "string",
      "defaultValue": "https://streamguard-frontend.vercel.app"
    },
    "databaseServerName": {
      "type": "string",
      "defaultValue": "[concat('streamguard-pg-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Globally unique Azure Database for PostgreSQL flexible server name."
      }
    },
    "databaseAdmin": {
      "type": "string",
      "defaultValue": "streamguard_admin",
      "metadata": {
        "description": "PostgreSQL administrator login used by the backend."
      }
    },
    "databasePassword": {
      "type": "securestring",
      "minLength": 12,
      "metadata": {
        "description": "PostgreSQL administrator password: 12-128 characters with upper case, lower case, numbers and symbols."
      }
    },
    "dataEncryptionKey": {
      "type": "securestring",
      "minLength": 32
    },
    "jwtSecret": {
      "type": "securestring",
      "minLength": 32
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2022-12-01",
      "name": "[parameters('databaseServerName')]",
      "location": "[parameters('location')]",
      "tags": {
        "application": "streamguard",
        "environment": "production"
      },
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('databaseAdmin')]",
        "administratorLoginPassword": "[parameters('databasePassword')]",
        "authConfig": {
          "activeDirectoryAuth": "Disabled",
          "passwordAuth": "Enabled"
        },
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2022-12-01",
      "name": "[concat(parameters('databaseServerName'), '/AllowAzureServices')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('databaseServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2022-12-01",
      "name": "[concat(parameters('databaseServerName'), '/streamguard')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('databaseServerName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', parameters('databaseServerName'), 'AllowAzureServices')]"
      ],
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "tags": {
        "application": "streamguard",
        "environment": "production"
      },
      "properties": {
        "zoneRedundant": false,
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "condition": "[equals(parameters('environmentResourceGroup'), resourceGroup().name)]"
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": {
        "application": "streamguard",
        "environment": "production"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', parameters('databaseServerName'), 'streamguard')]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId(parameters('environmentResourceGroup'), 'Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "secrets": [
            {
              "name": "database-url",
              "value": "[concat('jdbc:postgresql://', reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('databaseServerName')), '2022-12-01').fullyQualifiedDomainName, ':5432/streamguard?sslmode=require')]"
            },
            {
              "name": "database-password",
              "value": "[parameters('databasePassword')]"
            },
            {
              "name": "data-encryption-key",
              "value": "[parameters('dataEncryptionKey')]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "backend",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "PORT",
                  "value": "8080"
                },
                {
                  "name": "SPRING_PROFILES_ACTIVE",
                  "value": "cloud"
                },
                {
                  "name": "SPRING_FLYWAY_CREATE_SCHEMAS",
                  "value": "true"
                },
                {
                  "name": "FRONTEND_ORIGIN",
                  "value": "[parameters('frontendOrigin')]"
                },
                {
                  "name": "JDBC_DATABASE_URL",
                  "secretRef": "database-url"
                },
                {
                  "name": "PGUSER",
                  "value": "[parameters('databaseAdmin')]"
                },
                {
                  "name": "PGPASSWORD",
                  "secretRef": "database-password"
                },
                {
                  "name": "DATA_ENCRYPTION_KEY",
                  "secretRef": "data-encryption-key"
                },
                {
                  "name": "JWT_SECRET",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "MEDIA_STORAGE",
                  "value": "database"
                },
                {
                  "name": "MEDIA_DIR",
                  "value": "/tmp/streamguard-media"
                },
                {
                  "name": "MEDIA_WORK_DIR",
                  "value": "/tmp/streamguard-work"
                },
                {
                  "name": "MAX_VIEWERS",
                  "value": "6"
                },
                {
                  "name": "AI_PROVIDER",
                  "value": "local-rules"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/actuator/health",
                    "port": 8080,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/actuator/health",
                    "port": 8080,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/actuator/health",
                    "port": 8080,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 60,
                  "periodSeconds": 30,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1,
            "rules": [
              {
                "name": "http-concurrency",
                "http": {
                  "metadata": {
                    "concurrentRequests": "20"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "backendOrigin": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "databaseHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('databaseServerName')), '2022-12-01').fullyQualifiedDomainName]"
    }
  }
}
